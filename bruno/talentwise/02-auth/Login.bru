meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.data?.accessToken) {
    bru.setEnvVar("token", body.data.accessToken);
  }
}
