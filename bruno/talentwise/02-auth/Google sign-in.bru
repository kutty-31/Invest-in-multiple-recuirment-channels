meta {
  name: Google sign-in
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/google
  body: json
  auth: none
}

body:json {
  {
    "credential": "{{googleCredential}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.data?.accessToken) {
    bru.setEnvVar("token", body.data.accessToken);
  }
}
